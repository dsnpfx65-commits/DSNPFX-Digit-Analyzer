{
  "name": "DSNPFX Market Insight",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt && chmod +x .devcontainer/start-dashboard.sh",
  "postStartCommand": "bash .devcontainer/start-dashboard.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "DSNPFX Market Insight",
      "onAutoForward": "openBrowser"
    }
  }
}
